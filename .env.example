# ============================================================
# Mercado Libre Flex -> SimpliRoute Integration
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to the repository.
# ============================================================

# ---- Application ----
APP_ENV=development           # development | staging | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
TZ=America/Argentina/Buenos_Aires

# ---- Database (PostgreSQL) ----
# Local dev with docker-compose uses these defaults.
DATABASE_URL=postgresql+psycopg://mercado:mercado@localhost:5432/mercado

# ---- Mercado Libre OAuth ----
# Get from https://developers.mercadolibre.com/ -> your app
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Must match the redirect URI registered in the ML app
ML_REDIRECT_URI=http://localhost:8000/oauth/callback
# Seller account ID that owns the Flex orders
ML_SELLER_ID=
# Which ML order status triggers visit creation: paid | ready_to_ship
ML_TRIGGER_STATUS=ready_to_ship

# ---- SimpliRoute ----
SIMPLIROUTE_API_BASE=https://api.simpliroute.com
SIMPLIROUTE_TOKEN=

# ---- Geocoder ----
GEOCODER_BACKEND=google       # google | nominatim
GOOGLE_MAPS_API_KEY=
GEOCODER_MIN_CONFIDENCE=0.7

# ---- Alerts (Telegram) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_DEDUP_WINDOW_MINUTES=15

# ---- Scheduler / internal ----
# Shared secret required on POST /internal/run
INTERNAL_SECRET=change-me-to-a-long-random-string
# Cron cadence (informational; actual schedule is set in Railway)
CRON_INTERVAL_MINUTES=20
# Watchdog threshold: alert if no successful run in this many minutes
CRON_WATCHDOG_MINUTES=45

# ---- Retry tuning ----
SIMPLIROUTE_MAX_RETRIES=5
SIMPLIROUTE_BACKOFF_BASE_SECONDS=1
